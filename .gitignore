# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/
*.ipynb.summary.md

# Editor / tooling
.claude/

# Derived / downloaded data — regenerated by scripts
data/kasen_kn.h5
data/lanl_catalog.parquet
data/dust_generation/kasen_kn.h5
data/dust_generation/lanl_catalog.parquet
data/dust_generation/lanl_spectra.parquet
data/dust_generation/lanl_extinguished_spectra.parquet
data/dust_generation/lanl_extinguished_spectra_test.parquet
data/dust_generation/lanl_extinguished_photometry.parquet
data/dust_generation/hourglass_photometry.parquet

# LANL simulation cube (clone separately)
data/dust_generation/kn_sim_cube_v1/
data/dust_generation/kn_sim_cube_v1.tar.gz

# External resources (clone separately, not part of this repo)
data/dust_generation/romansims/
data/dust_generation/dustmaps/

# Local scratch / benchmarks
data/dust_generation/_bench_*.py
data/dust_generation/_sanity_*.py

# OpenUniverse early-windows pipeline — large inputs/outputs (regenerated / downloaded separately;
# the versioned artifacts are tracked by DVC via their .dvc pointer files)
data/openuniverse/*.hdf5
data/openuniverse/*.parquet
data/openuniverse/*.fits
data/openuniverse/*.fits.gz
# Generaciones superadas: el nombre limpio es el vigente, el sufijo marca lo obsoleto
# (.stale-cadence, .buggy-photometry, .stale-<fecha>). Ver data/openuniverse/README.md.
data/openuniverse/*.parquet.*
data/openuniverse/*.hdf5.*
!data/openuniverse/*.hdf5.dvc
data/openuniverse/*.npz.*
!data/openuniverse/*.npz.dvc
data/openuniverse/normalization.json.stale-*
# Cache de tokens completa (1.2 GB): derivada (la reconstruye training/openuniverse_data.py con
# split_seed=42), pero versionada por DVC igual, porque rehacerla en la otra maquina cuesta mas
# que bajarla y asi el split es el mismo bit a bit.
data/openuniverse/openuniverse_tokens.npz
# El recorte solo-test (60 MB) NO se ignora: va en git a proposito. Es lo unico que necesita la
# maquina de solo-lectura para correr run_evaluation_test_only.py, y en git llega con el mismo
# git pull que trae el checkpoint, sin esperar a que el demonio de Dropbox replique el remote DVC.
# Excepcion consciente a la regla de tamano: 60 MB pasa el umbral de aviso de GitHub (50 MB).

# Generated figure PDFs, reference papers and local caches
data/openuniverse/*.pdf
data/dust_generation/*.pdf
data/openuniverse_cache/
docs/papers/

# Training weights and Lightning logs — too heavy for git (track via DVC if needed)
training/checkpoints/
training/lightning_logs/
# Salida cruda de las corridas (decenas de MB de barras de progreso): las metricas que importan
# quedan en el mensaje del commit y en training/plots/
training/*.log

# Subproductos de compilacion de LaTeX (el .tex y el .pdf si se versionan)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Tool caches
.pytest_cache/
.ruff_cache/
src/kilonova.egg-info/

# CLAUDE.md y la memoria de Claude viven en Dropbox (~/Dropbox/Kilonova), compartidos entre
# las dos maquinas. El symlink NO se versiona: su destino absoluto difiere entre Linux y el Mac.
CLAUDE.md
